    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
